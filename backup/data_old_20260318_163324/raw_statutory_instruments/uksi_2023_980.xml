<P1 DocumentURI="http://www.legislation.gov.uk/uksi/2023/980/article/1/made" IdURI="http://www.legislation.gov.uk/id/uksi/2023/980/article/1" id="article-1">
<Pnumber>1</Pnumber>
<P1para>
<P2 DocumentURI="http://www.legislation.gov.uk/uksi/2023/980/article/1/1/made" IdURI="http://www.legislation.gov.uk/id/uksi/2023/980/article/1/1" id="article-1-1">
