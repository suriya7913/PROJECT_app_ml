      <p><span style="font-family:'Book Antiqua'">Neutral citation number: </span><neutralCitation style="font-family:'Book Antiqua'">[2026] UKFTT 00341 (GRC)</neutralCitation></p>
      <p class="Heading3" style="text-align:right"><span style="font-weight:bold;font-family:Arial"/><span class="Strong" style="font-style:normal;font-family:'Segoe UI'">Appeal Number: FT/D/2025/0943</span></p>
      <p style="margin-right:-0.06in"><courtType refersTo="#ukftt-grc" style="font-weight:bold;font-family:'Book Antiqua'">First-tier Tribunal </courtType></p>
      <p style="margin-right:-0.06in"><courtType refersTo="#ukftt-grc" style="font-weight:bold;font-family:'Book Antiqua'">(General Regulatory Chamber)</courtType></p>
      <p style="margin-right:-0.06in"><docJurisdiction refersTo="#jurisdiction-transport" style="font-weight:bold;font-family:'Book Antiqua';color:#000000">Transport</docJurisdiction></p>
      <p style="text-align:right"><span style="font-weight:bold;font-family:'Book Antiqua'">Heard on: </span><span style="font-weight:bold;font-family:'Book Antiqua';color:#000000">27 February 2026.</span></p>
      <p style="text-align:right"><span style="font-weight:bold;font-family:'Book Antiqua'">Decision given on: </span><docDate date="2026-03-11" refersTo="#decision" style="font-weight:bold;font-family:'Book Antiqua'">11 March 2026</docDate></p>
      <p><span style="font-weight:bold;font-family:'Book Antiqua'">Before Judge Brian Kennedy KC</span></p>
      <p><span style="font-weight:bold;font-family:'Book Antiqua'">Between:</span></p>
      <p style="text-align:center"><party as="#appellant" refersTo="#rana-ejaz-ahmed" style="font-family:'Book Antiqua'">Rana Ejaz Ahmed</party></p>
      <p style="text-align:right"><role refersTo="#appellant" style="font-weight:bold;font-family:'Book Antiqua'">Appellant</role></p>
      <p style="text-align:center"><span style="font-weight:bold;font-family:'Book Antiqua'">and</span></p>
      <p style="text-align:center"><party as="#respondent" refersTo="#the-registrar-of-approved-driving-instructors" style="font-family:'Book Antiqua'">The Registrar of Approved Driving Instructors</party></p>
      <p style="text-align:right"><role refersTo="#respondent" style="font-weight:bold;font-family:'Book Antiqua'">Respondent</role></p>
      <p><span style="font-weight:bold;font-family:'Book Antiqua'">Decision: </span><span style="font-family:'Book Antiqua'">The appeal is </span><span style="font-family:'Book Antiqua';color:#000000">Dismissed.</span></p>
      <p class="Heading1" style="text-align:center"><span class="Strong" style="font-weight:bold;font-family:'Segoe UI'">DECISION NOTICE</span></p>
