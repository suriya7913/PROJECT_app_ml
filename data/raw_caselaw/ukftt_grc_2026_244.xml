      <p class="Default"><courtType refersTo="#ukftt-grc"><span style="font-family:'Times New Roman'"/><span style="font-weight:bold;font-family:'Times New Roman'">First-Tier Tribunal </span></courtType></p>
      <p class="Default"><courtType refersTo="#ukftt-grc" style="font-weight:bold;font-family:'Times New Roman'">(General Regulatory Chamber) </courtType></p>
