      <p style="text-align:right"><span style="font-weight:bold;font-family:'Book Antiqua'">Decision given on: </span><docDate date="2026-03-17" refersTo="#decision" style="font-weight:bold;font-family:'Book Antiqua'">17 March 2026</docDate></p>
      <p style="text-align:center"><span style="font-weight:bold;font-family:'Book Antiqua'">Before</span></p>
      <p style="text-align:center"><span style="font-weight:bold;font-family:'Book Antiqua'">JUDGE ROPER</span></p>
      <p style="text-align:center"><span style="font-weight:bold;font-family:'Book Antiqua'">Between</span></p>
      <p style="text-align:center"><party as="#appellant" refersTo="#naveed-adnan" style="font-weight:bold;text-transform:uppercase;font-family:'Book Antiqua'">NAVEED ADNAN</party></p>
      <p style="text-align:right"><role refersTo="#appellant" style="text-decoration-line:underline;text-decoration-style:solid;font-family:'Book Antiqua'">Appellant</role></p>
