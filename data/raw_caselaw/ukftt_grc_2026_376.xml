      <p><span style="font-family:'Book Antiqua';color:#000000">Neutral citation number: </span><neutralCitation style="font-family:'Book Antiqua';color:#000000">[2026] UKFTT 00376 (GRC)</neutralCitation></p>
      <p style="text-align:right"><span style="font-family:'Book Antiqua'"> Case Reference: FT/D/2025/0990</span></p>
      <p style="margin-right:-0.06in"><courtType refersTo="#ukftt-grc" style="font-weight:bold;font-family:'Book Antiqua'">First-tier Tribunal </courtType></p>
