      <p style="text-align:center"><span style="font-weight:bold;font-family:'Book Antiqua'">Before</span></p>
      <p style="text-align:center"><span style="font-weight:bold;font-family:'Book Antiqua'">JUDGE TAFT</span></p>
      <p style="text-align:center"><span style="font-weight:bold;font-family:'Book Antiqua'">Between</span></p>
      <p style="text-align:center"><party as="#appellant" refersTo="#christopher-brian-jones" style="font-weight:bold;text-transform:uppercase;font-family:'Book Antiqua'">CHRISTOPHER bRIAN JONES</party></p>
      <p style="text-align:right"><role refersTo="#appellant" style="text-decoration-line:underline;text-decoration-style:solid;font-family:'Book Antiqua'">Appellant</role></p>
      <p style="text-align:center"><span style="font-weight:bold;font-family:'Book Antiqua'">and</span></p>
      <p class="ListParagraph" style="text-align:center;margin-left:0in"><party as="#respondent" refersTo="#registrar-of-approved-driving-instructors" style="font-weight:bold;font-family:'Book Antiqua'">REGISTRAR OF APPROVED DRIVING INSTRUCTORS</party></p>
      <p style="text-align:right"><role refersTo="#respondent" style="text-decoration-line:underline;text-decoration-style:solid;font-family:'Book Antiqua'">Respondent</role></p>
      <p><span style="font-weight:bold;font-family:'Book Antiqua'">Decision: </span><span style="font-family:'Book Antiqua'">The appeal is Dismissed</span></p>
